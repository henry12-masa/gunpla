---
import Base from "../layouts/Base.astro";
import AmazonBox from "../components/AmazonBox.astro";
import { GRADES, kitsUrl, loadGames } from "../lib/kits";
import { gradeInfo, toolLinks } from "../lib/amazon";

const { games, cacheHint } = await loadGames();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const items = Object.entries(GRADES)
	.map(([slug, label]) => {
		const info = gradeInfo(slug);
		const list = games.filter((g) => g.grades.some((p) => p.slug === slug));
		const picks = list.filter((g) => g.tier === "essential").slice(0, 4);
		const fallback = picks.length ? picks : list.slice(0, 3);
		return info ? { slug, label, info, count: list.length, picks: fallback } : null;
	})
	.filter((x): x is NonNullable<typeof x> => !!x);

// 作りやすさで3つに分ける
const groups = [
	{ id: "g-easy", label: "はじめての人に", note: "道具が少なくても、短い時間で完成するグレード。", items: items.filter((x) => x.info.level <= 1) },
	{ id: "g-std", label: "定番のグレード", note: "種類が多く、好きな機体が見つかりやすいグレード。", items: items.filter((x) => x.info.level >= 2 && x.info.level <= 3 && !["hirm", "mega", "other", "re100", "fm", "mgsd"].includes(x.slug)) },
	{ id: "g-adv", label: "じっくり作り込む", note: "部品が細かい、または大きく、時間をかけて作るグレード。", items: items.filter((x) => x.info.level >= 4 && x.slug !== "kyukit") },
	{ id: "g-more", label: "もっと広く楽しむ", note: "1/100の新しいシリーズ、大きなサイズ、SDの作り込み、そして旧キット。", items: items.filter((x) => ["re100", "fm", "mgsd", "hirm", "mega", "kyukit", "other"].includes(x.slug)) },
];
const levelLabel = (n: number) => "★".repeat(n) + "☆".repeat(5 - n);
---

<Base title="グレードガイド" description="EG・HG・RG・MG・PGなど、ガンプラのグレードの違いと選び方、代表的なキットをまとめたガイド。">
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">Grades</p>
			<h1 class="intro__title">グレードガイド</h1>
			<p class="intro__lead">
				ガンプラには「グレード」という区分があり、大きさや部品の数、作り込みの細かさが違います。同じ機体でも、グレードが違えばまったく別の楽しみ方になります。それぞれの特徴と、代表的なキットをまとめました。作りやすさの★は、このサイトの目安です。
			</p>
		</div>
	</header>

	<nav class="band hw-nav" aria-label="グレードへ移動">
		<div class="frame">
			<ul>
				{groups.map((g) => g.items.length > 0 && <li><a href={`#${g.id}`}>{g.label}</a></li>)}
			</ul>
		</div>
	</nav>

	{
		groups
			.filter((g) => g.items.length > 0)
			.map((group) => (
				<section class="band section" id={group.id} aria-labelledby={`${group.id}-h`}>
					<div class="frame">
						<h2 id={`${group.id}-h`} class="group-title">{group.label}</h2>
						<p class="group-note">{group.note}</p>
						<div class="hw-grid">
							{group.items.map(({ slug, label, info, count, picks }) => (
								<article class="hw" id={slug}>
									<header class="hw__head">
										<h3 class="hw__name">{label}</h3>
										<p class="hw__meta">
											{info.scale}
											<span> · {info.since}年から</span>
											<span> · 作りやすさ <span class="level" aria-label={`5段階中${6 - info.level}`}>{levelLabel(6 - info.level)}</span></span>
										</p>
									</header>
									<p class="hw__desc">{info.desc}</p>
									<p class="hw__note">{info.tip}</p>
									{picks.length > 0 && (
										<p class="hw__picks">
											代表的なキット:
											{picks.map((g, i) => (
												<>
													{i > 0 && "、"}
													<a href={`/kits/${g.slug}`}>{g.title}</a>
												</>
											))}
										</p>
									)}
									<div class="hw__actions">
										{count > 0 && (
											<a href={kitsUrl({ grade: slug })} class="btn btn--ghost btn--sm">
												厳選 {count}件
											</a>
										)}
										<a href={`/catalog/${slug}`} class="btn btn--ghost btn--sm">
											全キット名簿
										</a>
										{info.amazon && (
											<a href={info.amazon.url} class="hw__amazon" rel="sponsored noopener" target="_blank">
												<span class="pr">PR</span>
												{info.amazon.label} ↗
											</a>
										)}
									</div>
								</article>
							))}
						</div>
					</div>
				</section>
			))
	}

	<section class="band section" aria-labelledby="tools-h">
		<div class="frame">
			<h2 id="tools-h" class="group-title">最初にそろえたい道具</h2>
			<p class="group-note">EG以外のキットは、ニッパーが1本あれば作れます。仕上がりをきれいにしたくなったら、少しずつ道具を足していきましょう。</p>
			<AmazonBox title="道具をAmazonで探す" links={toolLinks()} />
		</div>
	</section>
</Base>

<style>
	.hw-nav {
		position: sticky;
		top: var(--header-height, var(--nav-height));
		z-index: 5;
		background: color-mix(in oklab, var(--color-bg) 88%, transparent);
		backdrop-filter: blur(8px);
	}

	.hw-nav ul {
		list-style: none;
		display: flex;
		gap: var(--spacing-1);
		padding-block: var(--spacing-3);
		overflow-x: auto;
		scrollbar-width: none;
	}

	.hw-nav a {
		display: inline-block;
		padding: var(--spacing-1) var(--spacing-3);
		border-radius: var(--radius-full);
		font-size: var(--font-size-sm);
		white-space: nowrap;
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.hw-nav a:hover {
		background: var(--color-surface);
		color: var(--color-text);
	}

	section[id] {
		scroll-margin-top: calc(var(--header-height, var(--nav-height)) + 56px);
	}

	.group-title {
		margin-bottom: var(--spacing-5);
		font-size: var(--font-size-2xl);
	}

	.hw-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
		gap: var(--spacing-4);
	}

	.hw {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
		padding: var(--spacing-5);
		background: var(--color-surface);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-card);
		scroll-margin-top: calc(var(--header-height, var(--nav-height)) + 64px);
	}

	.hw__name {
		font-size: var(--font-size-xl);
	}

	.hw__meta {
		margin-top: var(--spacing-1);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.hw__note {
		margin-top: var(--spacing-1);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.hw__desc {
		font-size: var(--font-size-sm);
		line-height: 1.8;
		color: var(--color-text-secondary);
	}

	.hw__picks {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.hw__picks a {
		color: var(--color-text);
	}

	.hw__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-2);
		margin-top: auto;
	}

	.hw__amazon {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
		min-height: 2rem;
		padding: var(--spacing-1) var(--spacing-3);
		border-radius: var(--radius-full);
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-size: var(--font-size-xs);
		font-weight: 500;
		text-decoration: none;
	}

	.hw__amazon:hover {
		background: var(--color-brand-hover);
	}

	.pr {
		padding: 0 0.3rem;
		border-radius: 3px;
		background: color-mix(in oklab, var(--color-on-brand) 22%, transparent);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.05em;
	}

	.group-note {
		margin: calc(var(--spacing-2) * -1) 0 var(--spacing-5);
		color: var(--color-text-secondary);
		font-size: var(--font-size-sm);
	}

	.level {
		letter-spacing: 0.05em;
		color: var(--color-brand);
	}
</style>
